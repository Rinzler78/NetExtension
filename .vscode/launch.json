{
      "version": "0.2.0",
      "configurations": [
          {
              "name": ".NET Core Launch (console)",
              "type": "coreclr",
              "request": "launch",
              "preLaunchTask": "build",
              "program": "${workspaceFolder}/src/Rinzler78.NetExtension.Tests/bin/Debug/net8.0/Rinzler78.NetExtension.Tests.dll",
              "args": [],
              "cwd": "${workspaceFolder}/src/Rinzler78.NetExtension.Tests",
              "console": "internalConsole",
              "stopAtEntry": false
          },
          {
              "name": ".NET Core Attach",
              "type": "coreclr",
              "request": "attach"
          },
          {
              "name": "Debug Tests",
              "type": "coreclr",
              "request": "launch",
              "preLaunchTask": "build",
              "program": "dotnet",
              "args": [
                  "test",
                  "${workspaceFolder}/src/Rinzler78.NetExtension.Tests/Rinzler78.NetExtension.Tests.csproj",
                  "--logger:console;verbosity=detailed"
              ],
              "cwd": "${workspaceFolder}",
              "console": "integratedTerminal",
              "stopAtEntry": false
          }
      ]
}
